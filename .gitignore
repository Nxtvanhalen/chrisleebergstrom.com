# Dependencies
node_modules/
/.pnp
.pnp.js

# Production builds
/.next/
/out/
.vercel
*.tsbuildinfo

# Next.js auto-generated TypeScript reference — regenerated between
# dev (./.next/dev/types/routes.d.ts) and build (./.next/types/routes.d.ts)
# which causes local churn. Next creates it on demand; no value in tracking.
next-env.d.ts

# Environment variables — only the documented template is tracked
.env*
!.env.example
.env.sentry-build-plugin
.sentryclirc

# Claude Code session settings
.claude/

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Package manager lock (using bun)
package-lock.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
*.log

# Image/video originals don't belong in the served public/ directory
public/**/*.heif
public/**/*.heic

# Temporary files
*.tgz
*.tar.gz
