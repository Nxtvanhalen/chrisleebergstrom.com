# Environment variables read by this codebase. Copy to .env.local for development
# (git ignores every .env* file except this one). On Render, set them in the service's
# Environment tab. Never put real values in this file.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# DeepSeek key for EVE, the site chat (app/api/chat/route.ts). The build itself never
# calls DeepSeek, so CI uses a placeholder.
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Sentry (optional)
# ---------------------------------------------------------------------------
# Uploads source maps during `next build` (next.config.js). Unset = build still
# succeeds, stack traces in Sentry are just unminified less nicely.
SENTRY_AUTH_TOKEN=
# Environment tag on Sentry events (sentry.shared.ts). Defaults to "production".
NEXT_PUBLIC_SENTRY_ENV=

# ---------------------------------------------------------------------------
# Request filtering (proxy.ts, optional)
# ---------------------------------------------------------------------------
# "true" sends the CSP as Content-Security-Policy-Report-Only: violations are reported
# to Sentry but nothing is blocked. Anything else (or unset) enforces.
CSP_REPORT_ONLY=
# Comma-separated client IPs that get a 403 on every request. Empty/unset = no IP blocking.
BLOCKED_IPS=
# Comma-separated IPv4 prefixes, each ending in a dot (e.g. "43.131.,170.106."). Requests
# from these ranges whose User-Agent claims to be a phone (iPhone/Android) get a 403 —
# the fake-mobile heuristic. Empty/unset = check disabled.
BLOCKED_IP_PREFIXES=

# ---------------------------------------------------------------------------
# EVE brief (optional)
# ---------------------------------------------------------------------------
# EVE's "what is Chris building" brief is Markdown in a private GitHub repo,
# fetched at runtime (app/api/chat/brief.ts) and cached for ten minutes, so Chris
# can update it without a deploy. Unset = the committed content/eve/brief.md is
# used. Fine-grained personal access token: repository access = eve-brief only,
# permissions = Contents: Read-only, nothing else. Set an expiry and renew it;
# an expired token shows up as a Sentry warning and EVE keeps the last copy.
EVE_BRIEF_TOKEN=
# Where the brief lives. Defaults: Nxtvanhalen/eve-brief, brief.md, main.
EVE_BRIEF_REPO=
EVE_BRIEF_PATH=
EVE_BRIEF_REF=

# ---------------------------------------------------------------------------
# Set by the platform, not by you
# ---------------------------------------------------------------------------
# NODE_ENV, NEXT_RUNTIME  — Next.js
# CI                      — GitHub Actions (when set, the Sentry build plugin logs verbosely)
